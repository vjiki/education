// Given sorted slices A and B. Slices keep unique values.
// Produce a union of them into sorted slice C without duplicates.
// A = [1, 3, 5, 7]
// B = [1, 2, 3, 7, 9]
// C = [1, 2, 3, 5, 7, 9]

public int[] getUnion(int[] a, int[] b) {
    List<Integer> list = new ArrayList<Integer>;

    if (a.length == 0 && b.length == 0) {
        return new int[];
    }

    int firstPointer = 0;
    int secondPointer = 0;

    // A = [1, 3, 5, 7]
    // B = [1, 2, 3, 7, 9]
    while (firstPointer < a.length && secondPointer <  b.length) {
        int firstValue = a[firstPointer];
        int secondValue = b[secondPointer];
        if (firstValue == secondValue) {
            list.add(firstValue);
            firstPointer++;
            secondPointer++;
        } else if (firstValue < secondValue) {
            list.add(firstValue);
            firstPointer++;
        } else {
            list.add(secondValue);
            secondPointer++;
        }
    }

    while (secondPointer < b.lenght) {
        list.add(b[secondPointer]);
        secondPointer++;
    }

    while (firstPointer < a.lenght) {
        list.add(a[firstPointer]);
        firstPointer++;
    }

    return list.toArray();
}