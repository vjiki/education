//2) написать свой класс, который бы реализовывал стек, с методами push, pop,  и peekMax, который бы возращал max Элемент в стеке за О(1)


public class MyStack { // T

    private final PriorityQueue<Integer> queue; // TODO syntax
    private final LinkedList<Integer> list = new LinkedList<>();

    void MyStack(Comporator cmp) {
        this.queue = new PriorityQueue<>(cmp);
    }

    void push(Integer elem) {
        list.add(elem);
        queue.push(elem);
    }

    Integer pop() {
        Integer elem = list.getLast();
        list.remove(elem);
        queue.remove(elem);
        return elem;
    }

    Integer peekMax() {
        return queue.peek();
    }
}






public void process(String oldName, String newName) {

    Long id = exec("select id from file where name='" + oldName + "'");
