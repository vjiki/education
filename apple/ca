class JobScheduler {

  private PriorityQueue<Job> pq = new PriorityQueue<>(Comparator.reverseOrder());
  private Set<Job> notReadyJobs = new HashSet<>();


  public void addJob(Job job) {
    if (job.isReadyToRun()) {
       pq.add(job);
    } else {
       notReadyJobs.add(job);
    }
  }
  public void runAllJobs() {
    ExecutorService executor = Executors.newSingleThreadExecutor();

    while (!pq.isEmpty() && !notReadyJobs.isEmpty()) {
      Job job = pq.poll();
      executor.submit(job);
      if (!job.isDone()) {
        try {
        Thread.sleep(100);
        } catch (Exception e) {
          System.out.println(e);
        }
      } else {
        List<Job> readyToRunJobs = notReadyJobs.stream().filter(Job::isReadyToRun).toList();
        if (!readyToRunJobs.isEmpty()) {
            for (Job j : readyToRunJobs) {
              pq.add(j);
            }
        }
      }
    }
  }
}

class Job implements Runnable, Comparable<Job> {
   private int priority;
   private Set<Job> dependencies;
   private boolean isDone = false;
   private int jobId;

   public void Job(int jobId, int priority, Set<Job> dependencies) {
      this.priority = priority;
      this.dependencies = dependencies;
      this.jobId = jobId;
   }

   public boolean isReadyToRun() {
    if (dependencies.stream().filter(e -> !e.isDone()).count() > 0) {
      return false;
    }
     return true;
   }

   public boolean isDone() {
    return isDone;
   }

   @Override
   public void run() {
      System.out.println("priority" + priority + "jobId" + jobId);
      this.isDone = true;
   }

   @Override
   public int compareTo(Job o) {
    return new Integer(this.priority).compareTo(o.priority);
   }
}


