// Эта задача решается через ConcurrentHashMap() для каждого потока отдельный счетчик и когда нужно сделать гет они складываются


Есть теоретическая машина на 100 ядер, на нём запущен HTTP сервер на Java, который работает на 100 потоках. Всё что делает этот сервер -- считает количество запросов на него с момента старта сервера.

То есть, условно, есть два метода:

@Singleton
public class Handler {
    /**
     * Этот метод записывает информацию о каждом разе, когда он был вызван и ничего не возвращает.
     * Этот метод находится под большой нагрузкой, мы хотим иметь максимальную пропускную способность для него.
     */
    @POST("/register_event")
    public void registerEvent(Req req) {
        //
    }

    /**
     * Этот метод возвращает сколько раз был вызван метод /register_event с момента старта сервера.
     * Этот метод вызывается редко, 1 раз в минуту.
     */
    @GET("/events_number")
    public int registerEvent(Req req) {
        return //...
    }
}

Как реализовать сервер-счётчик максимально эффективно с точки зрения пропускной способности в единицу времени?


import javax.inject.Singleton;
import java.util.concurrent.ConcurrentHashMap;
import java.util.concurrent.atomic.AtomicInteger;

@Singleton
public class Handler {

    // ConcurrentHashMap to store event counts (key: event, value: count)
    private final ConcurrentHashMap<String, AtomicInteger> eventCounts = new ConcurrentHashMap<>();

    /**
     * Этот метод записывает информацию о каждом разе, когда он был вызван и ничего не возвращает.
     * Этот метод находится под большой нагрузкой, мы хотим иметь максимальную пропускную способность для него.
     */
    @POST("/register_event")
    public void registerEvent(Req req) {
        // Получаем или создаём новый счётчик для данного события (например, "register_event")
        eventCounts
            .computeIfAbsent("register_event", key -> new AtomicInteger(0))
            .incrementAndGet();
    }

    /**
     * Этот метод возвращает сколько раз был вызван метод /register_event с момента старта сервера.
     * Этот метод вызывается редко, 1 раз в минуту.
     */
    @GET("/events_number")
    public int getEventCount() {
        // Получаем количество событий по ключу
        AtomicInteger count = eventCounts.get("register_event");
        return (count != null) ? count.get() : 0;
    }
}


import java.util.concurrent.atomic.LongAdder;

private final LongAdder eventCount = new LongAdder();

@POST("/register_event")
public void registerEvent(Req req) {
    eventCount.increment();
}

@GET("/events_number")
public int getEventCount() {
    return eventCount.intValue();
}


import javax.inject.Singleton;
import java.util.concurrent.atomic.AtomicInteger;

@Singleton
public class Handler {

    // Атомарная переменная для подсчета количества событий
    private final AtomicInteger eventCount = new AtomicInteger(0);

    /**
     * Этот метод записывает информацию о каждом разе, когда он был вызван и ничего не возвращает.
     * Этот метод находится под большой нагрузкой, мы хотим иметь максимальную пропускную способность для него.
     */
    @POST("/register_event")
    public void registerEvent(Req req) {
        // Атомарно увеличиваем счетчик событий
        eventCount.incrementAndGet();
    }

    /**
     * Этот метод возвращает сколько раз был вызван метод /register_event с момента старта сервера.
     * Этот метод вызывается редко, 1 раз в минуту.
     */
    @GET("/events_number")
    public int getEventCount() {
        // Просто возвращаем текущее значение счетчика
        return eventCount.get();
    }
}






